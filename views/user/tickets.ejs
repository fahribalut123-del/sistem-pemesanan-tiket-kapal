<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — TiketKapal</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('../partials/navbar') %>

<div class="container mt-3">
  <h2 class="section-title">🎫 Tiket Saya</h2>

  <% if (tickets.length === 0) { %>
    <div class="alert alert-info text-center" style="padding:2.5rem;">
      <div style="font-size:2.5rem;">🎫</div>
      <h3>Belum ada tiket</h3>
      <p>Tiket akan muncul di sini setelah pembayaran diverifikasi oleh admin.</p>
      <a href="/cari" class="btn btn-primary mt-2">🔍 Cari Tiket Sekarang</a>
    </div>
  <% } else { %>
    <div class="schedule-grid">
      <% tickets.forEach(t => { %>
        <div class="card">
          <div class="card-top" style="background:linear-gradient(135deg,var(--navy),var(--ocean)); color:white; padding:.85rem 1.15rem; display:flex; justify-content:space-between; align-items:center;">
            <div>
              <div style="font-weight:700; font-family:monospace; letter-spacing:1px;"><%= t.ticket_code %></div>
              <div style="font-size:.8rem; opacity:.85;"><%= t.passenger_name %></div>
            </div>
            <span class="badge badge-success">Aktif</span>
          </div>
          <div style="padding:1rem 1.15rem;">
            <div class="d-flex justify-between align-center mb-1" style="font-size:.85rem;">
              <span class="text-muted"><%= t.origin_name %></span>
              <span>→</span>
              <span class="text-muted"><%= t.destination_name %></span>
            </div>
            <div class="d-flex justify-between mb-1" style="font-size:.85rem;">
              <span>📅 <%= t.departure_date %></span>
              <span>🕐 <%= t.departure_time %> WITA</span>
            </div>
            <div class="d-flex justify-between mb-1" style="font-size:.85rem;">
              <span>🚢 <%= t.ship_name %></span>
              <span>Kursi: <strong><%= t.seat_number || '-' %></strong></span>
            </div>
            <div class="d-flex justify-between" style="font-size:.85rem;">
              <span>Booking: <span class="text-muted"><%= t.booking_code %></span></span>
            </div>
          </div>
          <div style="padding:0 1.15rem 1rem; display:flex; gap:.5rem;">
            <a href="/tiket/<%= t.ticket_code %>" class="btn btn-primary btn-sm" style="flex:1;">👁️ Lihat Detail</a>
            <a href="/tiket/<%= t.ticket_code %>" class="btn btn-outline btn-sm" onclick="window.print()" style="flex:1;">🖨️ Cetak</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
</body>
</html>
